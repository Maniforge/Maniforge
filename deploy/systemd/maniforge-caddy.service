[Unit]
Description=Maniforge Caddy gateway (:18090)
After=network-online.target maniforge-rbac.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/maniforge/platform-core/deploy/.env.platform
ExecStart=/bin/bash -c '/usr/local/bin/caddy run --config "${MANIFORGE_CADDYFILE:-/opt/maniforge/platform-core/deploy/Caddyfile.server}" --adapter caddyfile'
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
