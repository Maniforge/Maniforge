[Unit]
Description=Maniforge RBAC
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/maniforge/platform-core
EnvironmentFile=/opt/maniforge/platform-core/deploy/.env.platform
ExecStart=/opt/maniforge/platform-core/bin/maniforge-rbac
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
