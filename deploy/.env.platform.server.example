# =============================================================================
# Maniforge platform — SERVER env example (nzgapp / 79.174.90.4)
# Copy → .env.platform, then:  bash scripts/server-init-env.sh
# Existing live file:          bash scripts/server-merge-env.sh
# Postgres: docker compose -f compose.platform.server.yml --env-file .env.platform up -d
# Go: native systemd (not Docker). Gateway: host Caddy on MANIFORGE_GATEWAY_PORT.
# =============================================================================
#
# APP_URL is scheme + host only. Do not put :18090 here — that is MANIFORGE_GATEWAY_PORT.
# Public origin = APP_URL + ":" + MANIFORGE_GATEWAY_PORT (scripts + Go joinPublicOrigin).
# Journeys: http://127.0.0.1:18090/rbac  (do not store a wall of journey URLs).
#
# Listen map:
#   MANIFORGE_GATEWAY_PORT (18090)  Caddy on host — public
#   127.0.0.1:8093–8097             Go on host loopback
#   127.0.0.1:18096 / 18097         Postgres published (in-container still 5432)
# =============================================================================

MANIFORGE_PUBLIC_HOST=79.174.90.4
MANIFORGE_GATEWAY_PORT=18090
APP_URL=http://79.174.90.4

MANIFORGE_PG_PRIMARY_PORT=18096
MANIFORGE_PG_REPLICA_PORT=18097

APP_NAME=maniforge-platform-core
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow

# Host-run Go talks to published primary (compose: 127.0.0.1:18096:5432).
MANIFORGE_DB_HOST=127.0.0.1
MANIFORGE_DB_PORT=18096
MANIFORGE_DB_NAME=maniforge
MANIFORGE_DB_USER=maniforge
MANIFORGE_DB_PASS=CHANGE_ME_MANIFORGE_DB_PASS
MANIFORGE_DB_SSLMODE=disable

REPLICATOR_PASSWORD=CHANGE_ME_REPLICATOR_PASSWORD

TENANCY_MODE=single
DEFAULT_TENANT_ID=default
DEFAULT_SUBTENANT_ID=default
TENANCY_HEADERS_REQUIRED=false

# Fiber listen — loopback on host (not Docker NAT, not the public IP).
MANIFORGE_RBAC_ADDR=127.0.0.1:8093
MANIFORGE_TENANT_LICENSING_ADDR=127.0.0.1:8094
MANIFORGE_MANIFEST_ENGINE_ADDR=127.0.0.1:8095
MANIFORGE_VERSIONING_ADDR=127.0.0.1:8096
MANIFORGE_REALTIME_ADDR=127.0.0.1:8097

# Do not store loopback http:// URLs here (Go does not expand ${VAR} in .env).
# Realtime: empty MANIFORGE_REALTIME_INTERNAL_URL → Go uses http:// + MANIFORGE_REALTIME_ADDR.
# Tenant Licensing: leave TENANT_LICENSING_INTERNAL_URL unset/empty → RBAC talks to the same
#   Postgres in-process (faster, no HTTP). Set a URL only if TL is on another host.
# RBAC: leave RBAC_INTERNAL_URL unset/empty → Go does not POST to RBAC. PHP dispatch_events
#   (optional) derives http:// + MANIFORGE_RBAC_ADDR + /rbac when it needs HTTP.
TENANT_LICENSING_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN
TENANT_LICENSING_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
TENANT_LICENSING_ENFORCEMENT=optional

RBAC_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN

RBAC_REGISTRATION_ENABLED=true
RBAC_REGISTRATION_DEFAULT_ROLE=user
RBAC_REGISTRATION_BOOTSTRAP_ROLE=tenant_admin
RBAC_REGISTRATION_PLAN=starter
RBAC_REGISTRATION_DEFAULT_SUBTENANT_ID=main
RBAC_REGISTRATION_DEFAULT_SUBTENANT_NAME="Main workspace"

VERSIONING_ENABLED=true
VERSIONING_FEATURE_ENFORCE=false
