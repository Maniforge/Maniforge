# =============================================================================
# Production overrides — merge into deploy/.env.platform (install-maniforge.sh
# applies these automatically when --domain is set).
#
# URL model (no duplicate service URLs):
#   APP_URL              scheme + host only (https://platform.example.com)
#   MANIFORGE_GATEWAY_PORT  443 for HTTPS domain, 18090 for IP staging
#   MANIFORGE_PUBLIC_HOST   FQDN or IP for scripts
# Public origin = joinPublicOrigin(APP_URL, MANIFORGE_GATEWAY_PORT) in Go.
# Journeys and verify scripts use public_origin() from server-public-urls.sh.
# =============================================================================

MANIFORGE_PUBLIC_HOST=platform.example.com
MANIFORGE_GATEWAY_PORT=443
APP_URL=https://platform.example.com

# Caddy config path (rendered from Caddyfile.production when using --domain)
MANIFORGE_CADDYFILE=/opt/maniforge/platform-core/deploy/Caddyfile.active

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow

# MANIFORGE_DB_SSLMODE=require
MANIFORGE_DB_SSLMODE=disable
# Set require when Postgres TLS is configured

# Single-host deploy: Go listens loopback; Caddy is the only public entry.
MANIFORGE_RBAC_ADDR=127.0.0.1:8093
MANIFORGE_TENANT_LICENSING_ADDR=127.0.0.1:8094
MANIFORGE_MANIFEST_ENGINE_ADDR=127.0.0.1:8095
MANIFORGE_VERSIONING_ADDR=127.0.0.1:8096
MANIFORGE_REALTIME_ADDR=127.0.0.1:8097

TENANCY_MODE=multi
TENANCY_HEADERS_REQUIRED=true

TENANT_LICENSING_ENFORCEMENT=strict
# Leave internal URLs empty on single-host deploy — Go derives from *_ADDR loopback.
TENANT_LICENSING_INTERNAL_TOKEN=CHANGE_ME_STRONG_RANDOM
TENANT_LICENSING_ADMIN_TOKEN=CHANGE_ME_STRONG_RANDOM

RBAC_INTERNAL_TOKEN=CHANGE_ME_STRONG_RANDOM

RBAC_REGISTRATION_ENABLED=false
RBAC_PII_ENCRYPTION_ENABLED=true
RBAC_PII_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

RBAC_PD_REGISTER_CONSENT_REQUIRED=true
RBAC_PD_REQUEST_SLA_DAYS=30

# Optional: run Go preflight before each service start (Docker entrypoint pattern)
# MANIFORGE_RUN_PREFLIGHT=true

# SIEM (optional)
# RBAC_SIEM_WEBHOOK_ENABLED=true
# RBAC_SIEM_WEBHOOK_URL=https://siem.example/hook

# Scheduler — configure systemd timers or cron separately (see PRODUCTION_BOX.md):
#   tenant-licensing expire_licenses (5–15 min)
#   dispatch_events (1–5 min)
#   make siem-forward (if SIEM enabled)
#   pd_retention_enforce (152-FZ schedule)
