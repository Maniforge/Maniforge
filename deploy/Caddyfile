:8080 {
	@rbac path /rbac /rbac/*
	handle @rbac {
		reverse_proxy rbac:8093
	}

	@tl path /tenant-licensing /tenant-licensing/*
	handle @tl {
		reverse_proxy tenant-licensing:8094
	}

	@versioning path /versioning /versioning/*
	handle @versioning {
		reverse_proxy versioning:8096
	}

	@manifest path /api/* /health /manifest-engine/*
	handle @manifest {
		reverse_proxy manifest-engine:8095
	}

	@realtime path /ws /ws/* /realtime /realtime/*
	handle @realtime {
		reverse_proxy realtime:8097
	}

	@warehouses path /warehouses /warehouses/*
	handle @warehouses {
		reverse_proxy warehouses:8098
	}

	@products path /products /products/*
	handle @products {
		reverse_proxy products:8099
	}

	@inventory path /inventory /inventory/*
	handle @inventory {
		reverse_proxy inventory:8100
	}

	@wms path /wms /wms/*
	handle @wms {
		reverse_proxy wms:8101
	}

	handle {
		respond "Maniforge platform gateway" 200
	}
}
