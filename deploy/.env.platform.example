# Copy to deploy/.env.platform before: make platform-up
# Local platform stack (docker compose). APP_ENV=local — без production guards.

APP_NAME=maniforge-platform-core
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Moscow

MANIFORGE_DB_HOST=postgres
MANIFORGE_DB_PORT=5432
MANIFORGE_DB_NAME=maniforge
MANIFORGE_DB_USER=maniforge
MANIFORGE_DB_PASS=maniforge
MANIFORGE_DB_SSLMODE=disable

TENANCY_MODE=single
DEFAULT_TENANT_ID=default
DEFAULT_SUBTENANT_ID=default
TENANCY_HEADERS_REQUIRED=false

MANIFORGE_RBAC_ADDR=:8093
MANIFORGE_TENANT_LICENSING_ADDR=:8094
MANIFORGE_MANIFEST_ENGINE_ADDR=:8095
MANIFORGE_VERSIONING_ADDR=:8096
MANIFORGE_REALTIME_ADDR=:8097

# Browser / UI (host machine)
MANIFORGE_MANIFEST_ENGINE_URL=http://127.0.0.1:8095
MANIFORGE_REALTIME_URL=ws://127.0.0.1:8097
MANIFORGE_REALTIME_INTERNAL_URL=http://realtime:8097

# RBAC → TL: пусто = in-process через общую PostgreSQL (проще для local compose)
TENANT_LICENSING_INTERNAL_URL=
TENANT_LICENSING_INTERNAL_TOKEN=dev-internal-token
TENANT_LICENSING_ADMIN_TOKEN=dev-admin-token
TENANT_LICENSING_ENFORCEMENT=optional

RBAC_INTERNAL_URL=http://rbac:8093/rbac
RBAC_INTERNAL_TOKEN=dev-internal-token

RBAC_REGISTRATION_ENABLED=true
RBAC_REGISTRATION_DEFAULT_ROLE=user
RBAC_REGISTRATION_BOOTSTRAP_ROLE=tenant_admin
RBAC_REGISTRATION_PLAN=starter
RBAC_REGISTRATION_DEFAULT_SUBTENANT_ID=main
RBAC_REGISTRATION_DEFAULT_SUBTENANT_NAME=Main workspace

VERSIONING_ENABLED=true
VERSIONING_FEATURE_ENFORCE=false

# Production profile (uncomment + set APP_ENV=production + MANIFORGE_RUN_PREFLIGHT=true on services)
# APP_ENV=production
# APP_DEBUG=false
# TENANT_LICENSING_ENFORCEMENT=strict
# TENANT_LICENSING_INTERNAL_URL=http://tenant-licensing:8094/tenant-licensing
# RBAC_PII_ENCRYPTION_ENABLED=true
# RBAC_PII_ENCRYPTION_KEY=<base64-32-bytes>
