# Copy to .env in this directory (do not commit secrets)
RBAC_URL=http://127.0.0.1:8093/rbac
MANIFEST_URL=http://127.0.0.1:8095

# After `./bin/maniforge-agency-demo-seed` (or make agency seed):
TENANT_ID=agency-demo
SUBTENANT_ID=main
PHONE=+79000000003
PASSWORD=DemoAdmin!12345

# Display name stored in issued_by
LOGIN=agency-admin

# Fresh install without seed: run scripts/00b_register_operator.sh
# then set PHONE/PASSWORD/TENANT_ID from its output.
