APP_NAME=maniforge-platform-core
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8092
APP_TIMEZONE=Europe/Moscow

# PHP-референс (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=test_calculation
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Go-контур (PostgreSQL) — основной runtime
MANIFORGE_DB_HOST=127.0.0.1
MANIFORGE_DB_PORT=5433
MANIFORGE_DB_NAME=maniforge
MANIFORGE_DB_USER=maniforge
MANIFORGE_DB_PASS=maniforge
MANIFORGE_DB_SSLMODE=disable

TENANCY_MODE=single
DEFAULT_TENANT_ID=default
DEFAULT_SUBTENANT_ID=default
TENANCY_HEADERS_REQUIRED=false

RBAC_SESSION_TTL_MINUTES=720
RBAC_REFRESH_TTL_DAYS=30
RBAC_MFA_STEPUP_MAX_AGE_SEC=900
RBAC_ACTION_TOKEN_TTL_SEC=900
RBAC_RATE_LIMIT_WINDOW_SEC=60
# WB-style: 300 req/min на пользователя (tenant+user_id), auth — по phone
RBAC_RATE_LIMIT_MAX=300
RBAC_RATE_LIMIT_LOGIN_MAX=300
RBAC_RATE_LIMIT_ADMIN_MAX=300
RBAC_ADMIN_REQUIRE_STEP_UP=true
RBAC_ADMIN_REQUIRE_MFA_ENROLLMENT=false
RBAC_ADMIN_ALLOWED_IPS=
RBAC_ADMIN_ALLOWED_HOUR_START_UTC=0
RBAC_ADMIN_ALLOWED_HOUR_END_UTC=23
RBAC_LOGIN_MAX_FAILS=5
RBAC_LOGIN_LOCK_MINUTES=15
RBAC_PASSWORD_MIN_LENGTH=12
RBAC_PASSWORD_HISTORY_CHECK=5
RBAC_BATCH_MAX_ITEMS=100
RBAC_REGISTRATION_ENABLED=true
RBAC_REGISTRATION_DEFAULT_ROLE=user
RBAC_REGISTRATION_BOOTSTRAP_ROLE=tenant_admin
RBAC_REGISTRATION_PLAN=starter
RBAC_REGISTRATION_DEFAULT_SUBTENANT_ID=main
RBAC_REGISTRATION_DEFAULT_SUBTENANT_NAME=Main workspace
RBAC_REGISTRATION_INVITE_TTL_HOURS=168
RBAC_RATE_LIMIT_REGISTER_MAX=30
# RBAC_EXPOSE_PLATFORM_LICENSING_TOKEN=false

TENANT_LICENSING_ENFORCEMENT=optional
TENANT_LICENSING_INTERNAL_URL=
TENANT_LICENSING_INTERNAL_TOKEN=
TENANT_LICENSING_ADMIN_TOKEN=
TENANT_LICENSING_CACHE_TTL_SEC=60
TENANT_LICENSING_TIMEOUT_SEC=2
TENANT_LICENSING_EVENT_BATCH=50
RBAC_INTERNAL_URL=http://127.0.0.1:8092/rbac

# Go services (docs/MANIFORGE_GO_MIGRATION.md) — параллельно PHP :8092
MANIFORGE_RBAC_ADDR=:8093
MANIFORGE_TENANT_LICENSING_ADDR=:8094
MANIFORGE_MANIFEST_ENGINE_ADDR=:8095
MANIFORGE_REALTIME_ADDR=:8097
MANIFORGE_REALTIME_URL=ws://127.0.0.1:8097
MANIFORGE_REALTIME_INTERNAL_URL=http://127.0.0.1:8097
# URL для браузерного UI templates/refine-manifest (CORS в local)
MANIFORGE_MANIFEST_ENGINE_URL=http://127.0.0.1:8095
# Go RBAC → Go TL (если не задано — in-process через общую PostgreSQL)
# TENANT_LICENSING_INTERNAL_URL=http://127.0.0.1:8094/tenant-licensing

# Production profile hints:
# APP_ENV=production
# TENANCY_MODE=multi
# TENANT_LICENSING_ENFORCEMENT=strict
# TENANT_LICENSING_ADMIN_TOKEN=<strong-random-token>
# TENANT_LICENSING_INTERNAL_TOKEN=<strong-random-token>
# RBAC_INTERNAL_TOKEN=<strong-random-token>  # POST /rbac/internal/v1/tenant-events (fallback: TENANT_LICENSING_INTERNAL_TOKEN)

# Enterprise rate limit / login lockout (Go RBAC, паритет PHP)
# RBAC_LOGIN_MAX_FAILS=5
# RBAC_LOGIN_LOCK_MINUTES=15
# RBAC_RATE_LIMIT_WINDOW_SEC=60
# RBAC_RATE_LIMIT_MAX=120
# RBAC_RATE_LIMIT_LOGIN_MAX=20
# RBAC_RATE_LIMIT_REGISTER_MAX=10
# RBAC_RATE_LIMIT_ADMIN_MAX=60

# HSTS (auto in APP_ENV=production; или явно)
# RBAC_HSTS_ENABLED=true
# RBAC_HSTS_MAX_AGE_SEC=31536000

# Tenant Licensing admin rate limit
# TL_RATE_LIMIT_WINDOW_SEC=60
# TL_RATE_LIMIT_MAX=60

# SIEM webhook (security events → outbox + async delivery)
# RBAC_SIEM_WEBHOOK_ENABLED=true
# RBAC_SIEM_WEBHOOK_URL=https://siem.example.com/ingest/maniforge
# RBAC_SIEM_WEBHOOK_SECRET=<hmac-secret>
# Scheduler: make siem-forward  (или bin/maniforge-siem-forward)

MANIFORGE_DEMO_TENANT=demo
MANIFORGE_DEMO_SUBTENANT=main
MANIFORGE_DEMO_PLAN=starter
MANIFORGE_DEMO_ADMIN_LOGIN=demo-admin
MANIFORGE_DEMO_ADMIN_PASSWORD=DemoAdmin!12345
MANIFORGE_DEMO_USER_LOGIN=demo-user
MANIFORGE_DEMO_USER_PASSWORD=DemoUser!12345
MANIFORGE_DEMO_SEATS_MAX=25

# 152-ФЗ / personal data (docs/152FZ_COMPLIANCE.md, docs/MANIFORGE_PD_PROCESSOR_PLATFORM.md)
# Платформа как обработчик ПДн (клиент-tenant = оператор)
# RBAC_PLATFORM_PROCESSOR_NAME=ООО «Maniforge Platform»
# RBAC_PLATFORM_PROCESSOR_INN=0000000000
# RBAC_PLATFORM_PROCESSOR_ADDRESS=г. Москва, …
# RBAC_PLATFORM_PROCESSOR_DPO_EMAIL=dpo@example.com
# RBAC_PLATFORM_DPA_URL=https://example.com/legal/dpa
RBAC_PD_REGISTER_CONSENT_REQUIRED=false
RBAC_PD_REQUEST_SLA_DAYS=30
RBAC_PD_NOTICE_MIN_PURPOSES=1
# RBAC_PII_ENCRYPTION_ENABLED=true
# RBAC_PII_ENCRYPTION_KEY=<base64-32-bytes>  # php -r "echo base64_encode(random_bytes(32));"
# RBAC_PII_BLIND_INDEX_KEY=<optional-separate-key>
# RBAC_AUDIT_RETENTION_DAYS=0
# RBAC_PD_RETENTION_REVOKE_CONSENTS=true
# RBAC_PD_DPA_REQUIRED=true
# RBAC_PD_DPA_EXEMPT_TENANTS=demo,default
# RBAC_PD_DPA_SELF_SIGN_ON_REGISTER=true

# Versioning module (Maniforge /versioning)
VERSIONING_ENABLED=true
# When true, requires features.versioning=true in tenant license plan
VERSIONING_FEATURE_ENFORCE=false
